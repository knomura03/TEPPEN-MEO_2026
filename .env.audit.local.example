# Phase audit accounts (LOCAL ONLY)
# This file is committed as a template. Copy it to .env.audit.local (gitignored) and fill values.

# Existing ADMIN / MANAGER / USER accounts for audit runs
AUDIT_ADMIN_EMAIL=knomura@cyder.studio
AUDIT_ADMIN_PASSWORD=change-me
